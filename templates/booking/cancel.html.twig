{% extends 'base.html.twig' %}

{% block title %}Réservation annulée — {{ studio_name }}{% endblock %}

{% block body %}
<section class="section">
    <div class="container" style="max-width: 720px;">
        <div class="bg-white p-4 p-md-5 rounded shadow-sm border text-center">
            <div class="mb-4">
                <i class="bi bi-x-circle text-muted" style="font-size: 4rem;"></i>
            </div>

            <h1 class="serif mb-3">Réservation annulée</h1>
            <p class="lead text-muted mb-4">Aucun montant n'a été débité. Votre demande n'a pas été enregistrée.</p>

            <p class="text-muted">
                Vous pouvez retenter votre réservation, ou me contacter directement pour discuter d'une autre formule.
            </p>

            <div class="mt-4 d-flex gap-2 justify-content-center flex-wrap">
                <a href="{{ path('app_services') }}" class="btn btn-outline-dark">Voir les prestations</a>
                <a href="{{ path('app_contact') }}" class="btn btn-dark">Me contacter</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
