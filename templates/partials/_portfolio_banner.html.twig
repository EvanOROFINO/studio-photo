{#
   Bandeau COMMUN à tous les portfolios : galerie photo, pages par thème, showreel vidéo.
   Même composant, même titre « Portfolio » partout ; seul le détail (nombre de photos,
   thème actif…) change, via `details`.

   Usage :
       {% include 'partials/_portfolio_banner.html.twig' with { details: '16 photos à découvrir' } %}
#}
{% set isVideo = current_site.videoSite|default(false) %}
<header class="page-header portfolio-banner">
    <div class="container">
        <p class="section-subtitle text-light opacity-50 mb-2">{{ current_site.iconEmoji|default('📸') }} {{ current_site.name|default(studio_name) }}</p>
        <h1>Portfolio</h1>
        <p class="portfolio-banner-tagline mx-auto">
            {% if isVideo %}
                Du jour J aux grands événements, la vidéo qui donne du sens et de l'impact à vos projets
            {% else %}
                Capturer l'émotion, sublimer l'instant : une sélection de mes images, classées par thème
            {% endif %}
        </p>
        {% if details|default('') %}
            <p class="portfolio-banner-details mt-2 small">{{ details }}</p>
        {% endif %}
    </div>
</header>
