<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold serif" href="{{ path('app_home') }}">
            <span class="me-2">{{ current_site.iconEmoji|default('📸') }}</span>{{ current_site.name|default(studio_name) }}
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                {% set route = app.request.attributes.get('_route') %}
                <li class="nav-item"><a class="nav-link {{ route == 'app_home' ? 'active' : '' }}" href="{{ path('app_home') }}">Accueil</a></li>
                {% if current_site.videoSite %}
                    {# ===== Navigation SITE VIDÉO ===== #}
                    <li class="nav-item"><a class="nav-link {{ route starts with 'app_showreel' or route == 'app_video_detail' ? 'active' : '' }}" href="{{ path('app_showreel') }}">Showreel</a></li>
                    <li class="nav-item"><a class="nav-link {{ route == 'app_video_packages' ? 'active' : '' }}" href="{{ path('app_video_packages') }}">Forfaits</a></li>
                    <li class="nav-item"><a class="nav-link {{ route == 'app_testimonials' ? 'active' : '' }}" href="{{ path('app_testimonials') }}">Avis</a></li>
                    <li class="nav-item"><a class="nav-link {{ route starts with 'app_blog' ? 'active' : '' }}" href="{{ path('app_blog') }}">Blog</a></li>
                    <li class="nav-item"><a class="nav-link {{ route == 'app_about' ? 'active' : '' }}" href="{{ path('app_about') }}">À propos</a></li>
                    <li class="nav-item"><a class="nav-link {{ route == 'app_faq' ? 'active' : '' }}" href="{{ path('app_faq') }}">FAQ</a></li>
                {% else %}
                    {# ===== Navigation SITE PHOTO ===== #}
                    <li class="nav-item"><a class="nav-link {{ route starts with 'app_gallery' or route == 'app_photo_show' ? 'active' : '' }}" href="{{ path('app_gallery') }}">Galerie</a></li>
                    <li class="nav-item"><a class="nav-link {{ route == 'app_services' ? 'active' : '' }}" href="{{ path('app_services') }}">Prestations</a></li>
                    <li class="nav-item"><a class="nav-link {{ route == 'app_availability' ? 'active' : '' }}" href="{{ path('app_availability') }}">Disponibilités</a></li>
                    <li class="nav-item"><a class="nav-link {{ route == 'app_testimonials' ? 'active' : '' }}" href="{{ path('app_testimonials') }}">Avis</a></li>
                    <li class="nav-item"><a class="nav-link {{ route == 'app_before_after' ? 'active' : '' }}" href="{{ path('app_before_after') }}">Avant/Après</a></li>
                    <li class="nav-item"><a class="nav-link {{ route == 'app_showreel' or route == 'app_video_detail' ? 'active' : '' }}" href="{{ path('app_showreel') }}">Showreel</a></li>
                    <li class="nav-item"><a class="nav-link {{ route starts with 'app_blog' ? 'active' : '' }}" href="{{ path('app_blog') }}">Blog</a></li>
                    <li class="nav-item"><a class="nav-link {{ route starts with 'app_shop' or route starts with 'app_cart' or route starts with 'app_order' ? 'active' : '' }}" href="{{ path('app_shop_index') }}"><i class="bi bi-bag me-1"></i>Boutique</a></li>
                    <li class="nav-item"><a class="nav-link {{ route == 'app_about' ? 'active' : '' }}" href="{{ path('app_about') }}">À propos</a></li>
                    <li class="nav-item"><a class="nav-link {{ route == 'app_faq' ? 'active' : '' }}" href="{{ path('app_faq') }}">FAQ</a></li>
                {% endif %}
                <li class="nav-item ms-lg-2">
                    <a class="btn btn-dark btn-sm px-3" href="{{ path('app_contact') }}">
                        <i class="bi bi-envelope me-1"></i>{{ 'nav.contact_btn'|trans }}
                    </a>
                </li>
                {% if all_sites|length > 1 %}
                <li class="nav-item ms-lg-2 dropdown">
                    <button type="button" class="btn btn-sm dropdown-toggle px-3" data-bs-toggle="dropdown"
                            style="background: {{ current_site.accentColor }}; color: #1a1a1a; font-weight: 600; border: none;"
                            aria-label="Changer de site">
                        {{ current_site.iconEmoji }} {{ current_site.isVideoSite ? 'Vidéo' : 'Photo' }}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><h6 class="dropdown-header">Découvrir aussi</h6></li>
                        {% for site in all_sites %}
                            <li>
                                <a class="dropdown-item {{ site.id == current_site.id ? 'active' : '' }}"
                                   href="{{ site.id == current_site.id ? '#' : path('app_site_switch', { slug: site.slug }) }}">
                                    {{ site.iconEmoji }} {{ site.name }}
                                    {% if site.id == current_site.id %}<i class="bi bi-check-lg ms-1"></i>{% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </li>
                {% endif %}
                <li class="nav-item ms-lg-2 dropdown">
                    <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-label="{{ 'language.select'|trans }}">
                        {{ app.request.locale|upper }}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item {{ app.request.locale == 'fr' ? 'active' : '' }}" href="{{ path('app_locale_switch', { locale: 'fr' }) }}">🇫🇷 Français</a></li>
                        <li><a class="dropdown-item {{ app.request.locale == 'en' ? 'active' : '' }}" href="{{ path('app_locale_switch', { locale: 'en' }) }}">🇬🇧 English</a></li>
                    </ul>
                </li>
                <li class="nav-item ms-lg-2">
                    <button type="button" id="themeToggle" class="btn btn-outline-secondary btn-sm theme-toggle" aria-label="{{ 'theme.toggle'|trans }}">
                        <i class="bi bi-sun-fill theme-icon-light"></i>
                        <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</nav>
