<nav class="navbar navbar-expand-xl navbar-light bg-white border-bottom sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold serif" href="{{ path('app_home') }}">
            <span class="me-2">{{ current_site.iconEmoji|default('📸') }}</span>{{ current_site.name|default(studio_name) }}
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto align-items-xl-center">
                {% set route = app.request.attributes.get('_route') %}
                {#
                   Liens « principaux » toujours visibles ; liens « secondaires » regroupés dans un menu « Plus »
                   sur écran large (11 liens + boutons ne tiennent pas sur une ligne), à plat dans le menu mobile.
                #}
                {% if current_site.videoSite %}
                    {# ===== Navigation SITE VIDÉO ===== #}
                    {% set primary = [
                        { label: 'Accueil', url: path('app_home'), active: route == 'app_home' },
                        { label: 'Showreel', url: path('app_showreel'), active: route starts with 'app_showreel' or route == 'app_video_detail' },
                        { label: 'Forfaits', url: path('app_video_packages'), active: route == 'app_video_packages' },
                        { label: 'Avis', url: path('app_testimonials'), active: route == 'app_testimonials' },
                        { label: 'Blog', url: path('app_blog'), active: route starts with 'app_blog' },
                        { label: 'À propos', url: path('app_about'), active: route == 'app_about' },
                        { label: 'FAQ', url: path('app_faq'), active: route == 'app_faq' },
                    ] %}
                    {% set secondary = [] %}
                {% else %}
                    {# ===== Navigation SITE PHOTO ===== #}
                    {% set primary = [
                        { label: 'Accueil', url: path('app_home'), active: route == 'app_home' },
                        { label: 'Galerie', url: path('app_gallery'), active: route starts with 'app_gallery' or route == 'app_photo_show' },
                        { label: 'Prestations', url: path('app_services'), active: route == 'app_services' },
                        { label: 'Disponibilités', url: path('app_availability'), active: route == 'app_availability' },
                        { label: 'Boutique', icon: 'bi-bag', url: path('app_shop_index'), active: route starts with 'app_shop' or route starts with 'app_cart' or route starts with 'app_order' },
                        { label: 'À propos', url: path('app_about'), active: route == 'app_about' },
                    ] %}
                    {% set secondary = [
                        { label: 'Avis', url: path('app_testimonials'), active: route == 'app_testimonials' },
                        { label: 'Avant/Après', url: path('app_before_after'), active: route == 'app_before_after' },
                        { label: 'Showreel', url: path('app_showreel'), active: route == 'app_showreel' or route == 'app_video_detail' },
                        { label: 'Blog', url: path('app_blog'), active: route starts with 'app_blog' },
                        { label: 'FAQ', url: path('app_faq'), active: route == 'app_faq' },
                    ] %}
                {% endif %}

                {% for link in primary %}
                    <li class="nav-item"><a class="nav-link {{ link.active ? 'active' : '' }}" href="{{ link.url }}">{% if link.icon is defined %}<i class="bi {{ link.icon }} me-1"></i>{% endif %}{{ link.label }}</a></li>
                {% endfor %}

                {% if secondary|length > 0 %}
                    {# Écran large : menu « Plus » #}
                    <li class="nav-item dropdown d-none d-xl-block">
                        <a class="nav-link dropdown-toggle {{ (secondary|filter(l => l.active)|length) > 0 ? 'active' : '' }}" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Plus</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            {% for link in secondary %}
                                <li><a class="dropdown-item {{ link.active ? 'active' : '' }}" href="{{ link.url }}">{{ link.label }}</a></li>
                            {% endfor %}
                        </ul>
                    </li>
                    {# Menu mobile (burger) : les mêmes liens, à plat #}
                    {% for link in secondary %}
                        <li class="nav-item d-xl-none"><a class="nav-link {{ link.active ? 'active' : '' }}" href="{{ link.url }}">{{ link.label }}</a></li>
                    {% endfor %}
                {% endif %}
                <li class="nav-item ms-xl-2">
                    <a class="btn btn-dark btn-sm px-3" href="{{ path('app_contact') }}">
                        <i class="bi bi-envelope me-1"></i>{{ 'nav.contact_btn'|trans }}
                    </a>
                </li>
                {% if all_sites|length > 1 %}
                {# Bascule Photos / Vidéo : les deux intitulés l'un au-dessus de l'autre, le site courant en couleur #}
                <li class="nav-item ms-xl-2 site-switch-item">
                    <div class="site-switch" role="group" aria-label="Changer de site">
                        {% for site in all_sites %}
                            {% set isCurrent = site.id == current_site.id %}
                            <a class="site-switch-link {{ isCurrent ? 'is-active' : '' }}"
                               href="{{ isCurrent ? '#' : path('app_site_switch', { slug: site.slug }) }}"
                               {% if isCurrent %}aria-current="page" style="background: {{ site.accentColor }};"{% endif %}>
                                <span aria-hidden="true">{{ site.iconEmoji }}</span> {{ site.isVideoSite ? 'Vidéo' : 'Photos' }}
                            </a>
                        {% endfor %}
                    </div>
                </li>
                {% endif %}
                <li class="nav-item ms-xl-2 dropdown">
                    <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-label="{{ 'language.select'|trans }}">
                        {{ app.request.locale|upper }}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item {{ app.request.locale == 'fr' ? 'active' : '' }}" href="{{ path('app_locale_switch', { locale: 'fr' }) }}">🇫🇷 Français</a></li>
                        <li><a class="dropdown-item {{ app.request.locale == 'en' ? 'active' : '' }}" href="{{ path('app_locale_switch', { locale: 'en' }) }}">🇬🇧 English</a></li>
                    </ul>
                </li>
                <li class="nav-item ms-xl-2">
                    <button type="button" id="themeToggle" class="btn btn-outline-secondary btn-sm theme-toggle" aria-label="{{ 'theme.toggle'|trans }}">
                        <i class="bi bi-sun-fill theme-icon-light"></i>
                        <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</nav>
