{% extends 'base.html.twig' %}

{% block title %}Connexion admin — {{ studio_name }}{% endblock %}

{% block body %}
<div class="container">
    <div class="login-card">
        <div class="text-center mb-4">
            <i class="bi bi-lock-fill fs-1 text-accent"></i>
            <h3 class="serif mt-3 mb-1">Espace administrateur</h3>
            <p class="text-muted small">Réservé au photographe</p>
        </div>

        {% if error %}
            <div class="alert alert-danger small">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post">
            <div class="mb-3">
                <label for="username" class="form-label">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Mot de passe</label>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <div class="form-check mb-3">
                <input type="checkbox" name="_remember_me" id="remember_me" class="form-check-input">
                <label class="form-check-label small" for="remember_me">Se souvenir de moi</label>
            </div>
            <button class="btn btn-dark w-100" type="submit">Se connecter</button>
        </form>

        <div class="text-center mt-4">
            <a href="{{ path('app_home') }}" class="small text-muted text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i>Retour au site
            </a>
        </div>
    </div>
</div>
{% endblock %}
