{% extends 'base.html.twig' %}

{% block title %}{{ current_site.name }} — Films corporate, mariage et clips à Lyon{% endblock %}
{% block meta_description %}{{ current_site.tagline }} {{ current_site.name }} à {{ studio_city }} : mariage, corporate, événementiel, clips & brand content.{% endblock %}

{% block body %}

    {# ============ HERO VIDEO ============ #}
    <section class="position-relative overflow-hidden text-white py-6"
             style="background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%); min-height: 80vh; display: flex; align-items: center;">
        <div class="container py-5">
            <div class="row align-items-center">
                <div class="col-lg-7" data-aos="fade-up">
                    <div class="badge bg-transparent border mb-3 px-3 py-2"
                         style="border-color: {{ current_site.accentColor }} !important; color: {{ current_site.accentColor }};">
                        🎬 {{ current_site.name|upper }}
                    </div>
                    <h1 class="display-3 fw-bold mb-4" style="font-family: 'Playfair Display', serif; line-height: 1.05;">
                        Raconter votre histoire<br>
                        <span style="color: {{ current_site.accentColor }}; font-style: italic;">en images animées.</span>
                    </h1>
                    <p class="lead mb-4" style="max-width: 540px; opacity: 0.85;">
                        {{ current_site.tagline|default('Du film de mariage aux contenus de marque, je capture l\'émotion et la mets en mouvement.') }}
                    </p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a href="{{ path('app_showreel') }}" class="btn btn-lg px-4"
                           style="background: {{ current_site.accentColor }}; color: #1a1a1a; font-weight: 700;">
                            ▶ Voir mon showreel
                        </a>
                        <a href="{{ path('app_contact') }}" class="btn btn-lg btn-outline-light px-4">
                            Discuter d'un projet
                        </a>
                    </div>
                </div>
                <div class="col-lg-5 text-center d-none d-lg-block" data-aos="fade-left" data-aos-delay="200">
                    <div class="position-relative" style="aspect-ratio: 1/1; max-width: 380px; margin-left: auto;">
                        {% if featuredVideos|length > 0 %}
                            <img src="{{ featuredVideos[0].thumbnailUrl }}"
                                 alt="{{ featuredVideos[0].title }}"
                                 class="w-100 h-100 rounded-3 shadow-lg"
                                 style="object-fit: cover; border: 3px solid {{ current_site.accentColor }};">
                            <div class="position-absolute top-50 start-50 translate-middle">
                                <div class="rounded-circle d-flex align-items-center justify-content-center"
                                     style="width: 80px; height: 80px; background: {{ current_site.accentColor }}; color: #1a1a1a; font-size: 32px;">
                                    ▶
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ============ SHOWREEL FEATURED ============ #}
    {% if featuredVideos|length > 0 %}
    <section class="py-6" style="background: var(--bs-body-bg);">
        <div class="container py-5">
            <div class="text-center mb-5" data-aos="fade-up">
                <span class="text-uppercase small fw-semibold" style="color: {{ current_site.accentColor }}; letter-spacing: 0.2em;">— Showreel</span>
                <h2 class="display-5 fw-bold mt-2" style="font-family: 'Playfair Display', serif;">Mes films <em style="color: {{ current_site.accentColor }};">en lumière</em></h2>
            </div>

            <div class="row g-4">
                {% for video in featuredVideos %}
                    <div class="col-12 col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 100 }}">
                        <div class="card border-0 shadow-sm h-100 overflow-hidden">
                            <div class="position-relative" style="aspect-ratio: 16/9; background: #000;">
                                <img src="{{ video.thumbnailUrl }}" alt="{{ video.title }}"
                                     class="w-100 h-100" style="object-fit: cover;" loading="lazy">
                                <a href="{{ video.embedUrl }}" class="glightbox position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center text-decoration-none"
                                   data-type="video">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                                         style="width: 60px; height: 60px; background: rgba(255,255,255,0.9); color: #1a1a1a; font-size: 22px;">▶</div>
                                </a>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title mb-1 fw-bold">{{ video.title }}</h5>
                                {% if video.category %}
                                    <small class="text-muted">
                                        {{ video.category.iconEmoji }} {{ video.category.name }}
                                        {% if video.duration %} · {{ video.duration }}{% endif %}
                                    </small>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="text-center mt-5">
                <a href="{{ path('app_showreel') }}" class="btn btn-lg btn-outline-dark px-4">
                    Voir tous mes films →
                </a>
            </div>
        </div>
    </section>
    {% endif %}

    {# ============ COMPTEURS STATS ============ #}
    <section class="py-5 text-white" style="background: {{ current_site.accentColor }};">
        <div class="container py-3">
            <div class="row g-4 text-center">
                <div class="col-6 col-md-3" data-aos="fade-up">
                    <div class="display-4 fw-bold counter" data-target="150" style="color: #1a1a1a; font-family: 'Playfair Display', serif;">0</div>
                    <div class="text-uppercase small fw-semibold" style="color: #1a1a1a; letter-spacing: 0.1em;">Films livrés</div>
                </div>
                <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="100">
                    <div class="display-4 fw-bold counter" data-target="60" style="color: #1a1a1a; font-family: 'Playfair Display', serif;">0</div>
                    <div class="text-uppercase small fw-semibold" style="color: #1a1a1a; letter-spacing: 0.1em;">Mariages filmés</div>
                </div>
                <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="200">
                    <div class="display-4 fw-bold counter" data-target="40" style="color: #1a1a1a; font-family: 'Playfair Display', serif;">0</div>
                    <div class="text-uppercase small fw-semibold" style="color: #1a1a1a; letter-spacing: 0.1em;">Clients pro</div>
                </div>
                <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="300">
                    <div class="display-4 fw-bold counter" data-target="8" style="color: #1a1a1a; font-family: 'Playfair Display', serif;">0</div>
                    <div class="text-uppercase small fw-semibold" style="color: #1a1a1a; letter-spacing: 0.1em;">Ans d'expérience</div>
                </div>
            </div>
        </div>
    </section>

    {# ============ CATÉGORIES ============ #}
    {% if categories|length > 0 %}
    <section class="py-6" style="background: var(--bs-tertiary-bg);">
        <div class="container py-5">
            <div class="text-center mb-5" data-aos="fade-up">
                <span class="text-uppercase small fw-semibold" style="color: {{ current_site.accentColor }}; letter-spacing: 0.2em;">— Mes spécialités</span>
                <h2 class="display-5 fw-bold mt-2" style="font-family: 'Playfair Display', serif;">Ce que je <em style="color: {{ current_site.accentColor }};">filme</em></h2>
            </div>

            <div class="row g-4">
                {% for category in categories %}
                    <div class="col-6 col-md-3" data-aos="zoom-in" data-aos-delay="{{ loop.index0 * 100 }}">
                        <a href="{{ path('app_showreel') }}?category={{ category.slug }}"
                           class="card border-0 h-100 text-center text-decoration-none p-4 shadow-sm"
                           style="background: var(--bs-body-bg); transition: transform 0.2s, box-shadow 0.2s;"
                           onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 24px rgba(0,0,0,0.12)';"
                           onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='';">
                            <div style="font-size: 56px;">{{ category.iconEmoji }}</div>
                            <h4 class="mt-3 mb-1 fw-bold">{{ category.name }}</h4>
                            {% if category.description %}
                                <p class="small text-muted mb-0">{{ category.description }}</p>
                            {% endif %}
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    {# ============ MON PROCESSUS ============ #}
    <section class="py-6" style="background: var(--bs-body-bg);">
        <div class="container py-4">
            <div class="text-center mb-5" data-aos="fade-up">
                <span class="text-uppercase small fw-semibold" style="color: {{ current_site.accentColor }}; letter-spacing: 0.2em;">— Comment ça marche</span>
                <h2 class="display-5 fw-bold mt-2" style="font-family: 'Playfair Display', serif;">De l'idée à <em style="color: {{ current_site.accentColor }};">l'écran</em></h2>
            </div>
            <div class="row g-4">
                {% set steps = [
                    {n: '01', t: 'Échange & devis', d: 'On discute de votre projet, vos envies, votre budget. Je vous fais une proposition claire sous 48h.'},
                    {n: '02', t: 'Préparation', d: 'Repérages, planning, déroulé. On cale tous les détails pour que le jour J soit fluide.'},
                    {n: '03', t: 'Tournage', d: 'Captation cinématographique, matériel pro, discret et bienveillant. Je capte l\'émotion sans la diriger.'},
                    {n: '04', t: 'Montage & livraison', d: 'Montage, étalonnage, musique. Vous recevez votre film en ligne + support physique, prêt à partager.'}
                ] %}
                {% for step in steps %}
                    <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 100 }}">
                        <div class="h-100 p-4 rounded-3" style="background: var(--bs-tertiary-bg);">
                            <div class="fw-bold mb-2" style="font-family: 'Playfair Display', serif; font-size: 36px; color: {{ current_site.accentColor }}; font-style: italic;">{{ step.n }}</div>
                            <h5 class="fw-bold mb-2">{{ step.t }}</h5>
                            <p class="small text-muted mb-0">{{ step.d }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ============ FORFAITS TEASER ============ #}
    <section class="py-6 text-center" style="background: var(--bs-tertiary-bg);">
        <div class="container py-4" data-aos="fade-up">
            <span class="text-uppercase small fw-semibold" style="color: {{ current_site.accentColor }}; letter-spacing: 0.2em;">— Tarifs transparents</span>
            <h2 class="display-5 fw-bold mt-2 mb-3" style="font-family: 'Playfair Display', serif;">Des forfaits pour <em style="color: {{ current_site.accentColor }};">chaque projet</em></h2>
            <p class="lead text-muted mb-4" style="max-width: 560px; margin: 0 auto;">Du film essentiel au film prestige 4K, trois formules claires — et le sur-mesure quand vous le souhaitez.</p>
            <a href="{{ path('app_video_packages') }}" class="btn btn-lg px-4" style="background: {{ current_site.accentColor }}; color: #1a1a1a; font-weight: 700;">
                Voir les forfaits & tarifs →
            </a>
        </div>
    </section>

    {# ============ MATÉRIEL ============ #}
    <section class="py-6 text-white" style="background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);">
        <div class="container py-4">
            <div class="row align-items-center g-5">
                <div class="col-lg-6" data-aos="fade-right">
                    <span class="text-uppercase small fw-semibold" style="color: {{ current_site.accentColor }}; letter-spacing: 0.2em;">— Mon matériel</span>
                    <h2 class="display-6 fw-bold mt-2 mb-4" style="font-family: 'Playfair Display', serif;">Du matériel <em style="color: {{ current_site.accentColor }};">cinéma</em>, au service de l'émotion</h2>
                    <div class="row g-3">
                        {% set gear = [
                            {i: '📷', t: 'Caméras 4K hybrides', d: 'Sony / Canon plein format'},
                            {i: '🚁', t: 'Drone homologué', d: 'Vues aériennes cinématiques'},
                            {i: '🎚️', t: 'Stabilisateurs', d: 'Mouvements fluides et précis'},
                            {i: '🎙️', t: 'Captation son HD', d: 'Micros-cravate + perche'}
                        ] %}
                        {% for g in gear %}
                            <div class="col-sm-6">
                                <div class="d-flex align-items-start gap-3 p-2">
                                    <div style="font-size: 28px;">{{ g.i }}</div>
                                    <div>
                                        <div class="fw-bold">{{ g.t }}</div>
                                        <div class="small opacity-75">{{ g.d }}</div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    {% if featuredVideos|length > 1 %}
                        <img src="{{ featuredVideos[1].thumbnailUrl }}" alt="Matériel vidéo"
                             class="w-100 rounded-3 shadow-lg" style="aspect-ratio: 16/10; object-fit: cover; border: 2px solid {{ current_site.accentColor }};">
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

    {# ============ FAQ ============ #}
    <section class="py-6" style="background: var(--bs-body-bg);">
        <div class="container py-4" style="max-width: 800px;">
            <div class="text-center mb-5" data-aos="fade-up">
                <span class="text-uppercase small fw-semibold" style="color: {{ current_site.accentColor }}; letter-spacing: 0.2em;">— Questions fréquentes</span>
                <h2 class="display-5 fw-bold mt-2" style="font-family: 'Playfair Display', serif;">Vous vous <em style="color: {{ current_site.accentColor }};">demandez</em> ?</h2>
            </div>
            <div class="accordion" id="faqVideo">
                {% set faqs = [
                    {q: 'Quel est le délai pour recevoir mon film ?', r: 'Entre 4 et 8 semaines selon le forfait. Vous recevez un teaser plus tôt pour patienter.'},
                    {q: 'Vous déplacez-vous hors de la région ?', r: 'Oui ! Le déplacement est inclus dans un rayon de 50 km. Au-delà, un forfait kilométrique s\'applique.'},
                    {q: 'Puis-je choisir la musique de mon film ?', r: 'Bien sûr. Je travaille avec des banques de musique sous licence, et le forfait Signature inclut une composition sur-mesure.'},
                    {q: 'Que se passe-t-il en cas de météo défavorable ?', r: 'Pour les tournages extérieurs, on prévoit toujours un plan B. Mon matériel est protégé et je sais m\'adapter.'},
                    {q: 'Combien de temps gardez-vous mes rushes ?', r: 'Je conserve vos fichiers sources pendant 12 mois après livraison, au cas où vous souhaiteriez une nouvelle version.'}
                ] %}
                {% for faq in faqs %}
                    <div class="accordion-item border-0 mb-2" style="background: var(--bs-tertiary-bg); border-radius: 8px;">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-semibold" style="background: var(--bs-tertiary-bg); box-shadow: none;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq{{ loop.index }}">
                                {{ faq.q }}
                            </button>
                        </h2>
                        <div id="faq{{ loop.index }}" class="accordion-collapse collapse" data-bs-parent="#faqVideo">
                            <div class="accordion-body text-muted">{{ faq.r }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ============ CTA FINAL ============ #}
    <section class="py-6 text-white text-center" style="background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);">
        <div class="container py-5" data-aos="fade-up">
            <h2 class="display-5 fw-bold mb-3" style="font-family: 'Playfair Display', serif;">
                Un projet vidéo <em style="color: {{ current_site.accentColor }};">en tête</em> ?
            </h2>
            <p class="lead mb-4 opacity-75" style="max-width: 600px; margin: 0 auto;">
                Mariage, événement corporate, clip, film publicitaire — je vous accompagne de l'idée à la diffusion.
            </p>
            <a href="{{ path('app_contact') }}" class="btn btn-lg px-4"
               style="background: {{ current_site.accentColor }}; color: #1a1a1a; font-weight: 700;">
                Parlons de votre projet
            </a>
        </div>
    </section>

    {# Optional script for GLightbox if not already loaded by base #}
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof GLightbox !== 'undefined') {
                GLightbox({ selector: '.glightbox' });
            }

            // Animation des compteurs au scroll
            const counters = document.querySelectorAll('.counter');
            const animateCounter = (el) => {
                const target = parseInt(el.dataset.target, 10);
                const duration = 1600;
                const start = performance.now();
                const step = (now) => {
                    const progress = Math.min((now - start) / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    el.textContent = Math.floor(eased * target) + (progress === 1 ? '+' : '');
                    if (progress < 1) requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
            };
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        animateCounter(entry.target);
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.5 });
            counters.forEach(c => observer.observe(c));
        });
    </script>

{% endblock %}
