{% extends 'base.html.twig' %}

{% block title %}Contact — {{ studio_name }}{% endblock %}

{% block body %}
<header class="page-header">
    <div class="container">
        <h1>Discutons de votre projet</h1>
        <p>Je vous réponds sous 48h ouvrées</p>
    </div>
</header>

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-5">
                <h3 class="serif mb-4">Coordonnées</h3>
                <ul class="list-unstyled">
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-envelope-fill text-accent fs-5 me-3 mt-1"></i>
                        <div>
                            <div class="small text-muted">Email</div>
                            <a href="mailto:{{ contact_email }}" class="text-decoration-none text-dark">{{ contact_email }}</a>
                        </div>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-telephone-fill text-accent fs-5 me-3 mt-1"></i>
                        <div>
                            <div class="small text-muted">Téléphone</div>
                            <a href="tel:{{ contact_phone|replace({' ': ''}) }}" class="text-decoration-none text-dark">{{ contact_phone }}</a>
                        </div>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-geo-alt-fill text-accent fs-5 me-3 mt-1"></i>
                        <div>
                            <div class="small text-muted">Basé à</div>
                            <span>{{ studio_city }}, France</span>
                            <div class="small text-muted mt-1">Déplacements partout en France</div>
                        </div>
                    </li>
                </ul>

                <hr class="my-4">

                <h5 class="serif">Suivez mon travail</h5>
                <div class="d-flex gap-3 mt-3">
                    <a href="{{ social_instagram }}" target="_blank" rel="noopener" class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-instagram me-1"></i>Instagram
                    </a>
                    <a href="{{ social_facebook }}" target="_blank" rel="noopener" class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-facebook me-1"></i>Facebook
                    </a>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="bg-white p-4 p-md-5 rounded shadow-sm border">
                    <h3 class="serif mb-4">Décrivez votre projet</h3>
                    {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_row(form.fullName) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.email) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.phone) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.projectType) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.eventDate) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.message) }}
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-dark btn-lg px-4">
                                    <i class="bi bi-send me-2"></i>Envoyer ma demande
                                </button>
                            </div>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
