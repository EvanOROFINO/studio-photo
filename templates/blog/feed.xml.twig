<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
    <channel>
        <title>{{ studio_name }} — Blog</title>
        <link>{{ url('app_blog') }}</link>
        <atom:link href="{{ url('app_blog_feed') }}" rel="self" type="application/rss+xml"/>
        <description>Conseils, coulisses et inspirations photo — {{ studio_name }}</description>
        <language>fr-FR</language>
        <lastBuildDate>{{ "now"|date('r') }}</lastBuildDate>

        {% for article in articles %}
            <item>
                <title>{{ article.title|e }}</title>
                <link>{{ url('app_blog_show', { slug: article.slug }) }}</link>
                <guid isPermaLink="true">{{ url('app_blog_show', { slug: article.slug }) }}</guid>
                <pubDate>{{ article.publishedAt|date('r') }}</pubDate>
                <category>{{ article.category.name|e }}</category>
                <description><![CDATA[{{ article.excerpt }}]]></description>
            </item>
        {% endfor %}
    </channel>
</rss>
