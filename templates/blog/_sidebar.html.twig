<div class="blog-sidebar">
    <div class="bg-light p-4 rounded mb-4">
        <h6 class="text-uppercase small fw-bold mb-3">Catégories</h6>
        <ul class="list-unstyled mb-0">
            {% for c in categories %}
                <li class="mb-2">
                    <a href="{{ path('app_blog_category', { slug: c.slug }) }}" class="text-decoration-none text-dark d-flex justify-content-between">
                        <span>{{ c.name }}</span>
                        <span class="text-muted small">{{ c.articles|length }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>

    <div class="bg-dark text-light p-4 rounded mb-4">
        <h6 class="text-uppercase small fw-bold mb-2"><i class="bi bi-bell me-1"></i>Newsletter</h6>
        <p class="small opacity-75 mb-3">Recevez mes derniers articles directement dans votre boîte mail.</p>
        <form method="post" action="{{ path('app_newsletter_subscribe') }}" class="d-flex gap-2">
            <input type="hidden" name="newsletter[_token]" value="{{ csrf_token('newsletter') }}">
            <input type="email" name="newsletter[email]" class="form-control form-control-sm" placeholder="votre@email.fr" required>
            <button type="submit" class="btn btn-light btn-sm"><i class="bi bi-send"></i></button>
        </form>
    </div>

    <div class="bg-light p-4 rounded">
        <h6 class="text-uppercase small fw-bold mb-3"><i class="bi bi-rss me-1"></i>Flux RSS</h6>
        <p class="small text-muted mb-3">Suivez ce blog dans votre lecteur RSS préféré.</p>
        <a href="{{ path('app_blog_feed') }}" class="btn btn-outline-dark btn-sm" target="_blank" rel="noopener">
            <i class="bi bi-rss me-1"></i>S'abonner au flux
        </a>
    </div>
</div>
