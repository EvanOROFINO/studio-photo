{% extends 'base.html.twig' %}

{% block title %}Foire aux questions — {{ studio_name }}{% endblock %}
{% block meta_description %}Réponses aux questions fréquentes : tarifs, déroulé des séances, délais de livraison…{% endblock %}

{% block body %}
<header class="page-header">
    <div class="container">
        <h1>Foire aux questions</h1>
        <p>Tout ce que vous voulez savoir avant de réserver</p>
    </div>
</header>

<section class="section">
    <div class="container" style="max-width: 820px;">
        {% set faqs = [
            { q: 'Comment réserver une séance ?', a: 'Remplissez le formulaire de contact en précisant vos envies. Je vous réponds sous 48h ouvrées avec un devis personnalisé. Une fois validé, un acompte de 30% confirme la réservation.' },
            { q: 'Quels sont vos tarifs ?', a: 'Mes tarifs varient selon le type de prestation. Une page dédiée détaille mes formules de base. Pour les mariages et événements, chaque devis est personnalisé.' },
            { q: 'Vous déplacez-vous ?', a: 'Oui, je me déplace partout en France. Pour les destinations hors de ' ~ studio_city ~ ', des frais de déplacement peuvent s\'appliquer.' },
            { q: 'Combien de temps pour recevoir mes photos ?', a: 'Comptez 2 à 3 semaines pour une séance courte (portrait, famille) et 4 à 6 semaines pour un mariage ou un événement plus important.' },
            { q: 'Sous quel format me livrez-vous les photos ?', a: 'Toutes les photos sont livrées en haute définition via une galerie privée en ligne. Vous pouvez les télécharger autant de fois que vous le souhaitez pendant 6 mois.' },
            { q: 'Retouchez-vous toutes les photos ?', a: 'Chaque photo livrée bénéficie d\'une retouche soignée (lumière, couleurs, contraste). La retouche dite "beauté" (peau, etc.) est plus poussée pour les portraits.' },
            { q: 'Puis-je vous demander de retirer certaines photos après livraison ?', a: 'Absolument. Sur simple demande, je retire les images que vous ne souhaitez pas voir publiées.' },
            { q: 'Acceptez-vous les paiements en plusieurs fois ?', a: 'Oui, pour les prestations supérieures à 500 €, un paiement en 3 fois sans frais est possible.' },
        ] %}

        <div class="accordion accordion-flush" id="faqAccordion">
            {% for f in faqs %}
                <div class="accordion-item border-bottom">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed serif fs-5" type="button" data-bs-toggle="collapse" data-bs-target="#faq{{ loop.index }}">
                            {{ f.q }}
                        </button>
                    </h2>
                    <div id="faq{{ loop.index }}" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">{{ f.a }}</div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="text-center mt-5">
            <p class="text-muted mb-3">Une autre question ?</p>
            <a href="{{ path('app_contact') }}" class="btn btn-dark px-4">Me contacter</a>
        </div>
    </div>
</section>
{% endblock %}
