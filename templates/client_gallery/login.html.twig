{% extends 'base.html.twig' %}

{% block title %}Galerie privée — {{ gallery.title }}{% endblock %}
{% block meta_description %}Galerie privée — accès réservé.{% endblock %}

{% block body %}
<div class="container">
    <div class="login-card">
        <div class="text-center mb-4">
            <i class="bi bi-lock-fill fs-1 text-accent"></i>
            <p class="section-subtitle mt-3 mb-1">Galerie privée</p>
            <h3 class="serif mb-1">{{ gallery.title }}</h3>
            <p class="text-muted small">Pour {{ gallery.clientName }}</p>
        </div>

        {% if error %}
            <div class="alert alert-danger small text-center">{{ error }}</div>
        {% endif %}

        <form method="post" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('client_gallery_login') }}">
            <div class="mb-3">
                <label for="password" class="form-label">Mot de passe</label>
                <input type="password" name="password" id="password" class="form-control" autocomplete="off" required autofocus>
                <div class="form-text">Le mot de passe vous a été communiqué par votre photographe.</div>
            </div>
            <button type="submit" class="btn btn-dark w-100">
                <i class="bi bi-unlock me-2"></i>Accéder à mes photos
            </button>
        </form>

        <div class="text-center mt-4">
            <a href="{{ path('app_home') }}" class="small text-muted text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i>Retour à l'accueil
            </a>
        </div>
    </div>
</div>
{% endblock %}
