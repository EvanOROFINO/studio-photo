{% extends 'base.html.twig' %}

{% block title %}{{ gallery.title }} — Galerie privée{% endblock %}
{% block meta_description %}Galerie privée — accès réservé.{% endblock %}

{% block body %}
<header class="page-header">
    <div class="container">
        <p class="section-subtitle text-light opacity-50 mb-2">
            <i class="bi bi-lock-fill me-1"></i>Galerie privée
        </p>
        <h1>{{ gallery.title }}</h1>
        <p>
            Bienvenue {{ gallery.clientName }} —
            {% if gallery.hasFilms %}{{ gallery.films|length }} film{{ gallery.films|length > 1 ? 's' : '' }}{% endif %}
            {% if gallery.hasFilms and gallery.photos|length > 0 %} · {% endif %}
            {% if gallery.photos|length > 0 %}{{ gallery.photos|length }} photo{{ gallery.photos|length > 1 ? 's' : '' }}{% endif %}
        </p>

        {% if gallery.allowDownload and gallery.photos|length > 0 %}
            <div class="mt-4">
                <a href="{{ path('app_client_gallery_download_all', { token: gallery.token }) }}" class="btn btn-light btn-lg px-4">
                    <i class="bi bi-cloud-download me-2"></i>Tout télécharger en ZIP
                </a>
            </div>
        {% endif %}

        <div class="mt-3">
            <a href="{{ path('app_client_gallery_logout', { token: gallery.token }) }}" class="small text-light opacity-75 text-decoration-none">
                <i class="bi bi-box-arrow-right me-1"></i>Se déconnecter
            </a>
        </div>
    </div>
</header>

<section class="section">
    <div class="container">
        {% if gallery.welcomeMessage %}
            <div class="bg-white p-4 rounded shadow-sm border mb-5">
                <p class="mb-0" style="white-space: pre-line;">{{ gallery.welcomeMessage }}</p>
            </div>
        {% endif %}

        {# ============ FILMS LIVRÉS ============ #}
        {% if gallery.hasFilms %}
            <div class="mb-5">
                <h3 class="serif mb-4"><i class="bi bi-film me-2"></i>Vos films</h3>
                <div class="row g-4">
                    {% for film in gallery.films %}
                        <div class="col-12 {{ gallery.films|length > 1 ? 'col-lg-6' : '' }}" data-aos="fade-up">
                            <div class="bg-white rounded shadow-sm border overflow-hidden">
                                <div class="ratio ratio-16x9" style="background: #000;">
                                    <iframe src="{{ film.embedUrl }}?rel=0"
                                            title="{{ film.title }}"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                            allowfullscreen
                                            loading="lazy"></iframe>
                                </div>
                                <div class="p-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="serif mb-1">{{ film.title }}</h5>
                                            {% if film.duration %}<small class="text-muted"><i class="bi bi-clock me-1"></i>{{ film.duration }}</small>{% endif %}
                                        </div>
                                        {% if film.downloadUrl %}
                                            <a href="{{ film.downloadUrl }}" target="_blank" rel="noopener" class="btn btn-dark btn-sm">
                                                <i class="bi bi-cloud-download me-1"></i>Télécharger en HD
                                            </a>
                                        {% endif %}
                                    </div>
                                    {% if film.description %}
                                        <p class="text-muted small mb-0 mt-2" style="white-space: pre-line;">{{ film.description }}</p>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% if gallery.photos|length > 0 %}
                <hr class="my-5">
                <h3 class="serif mb-4"><i class="bi bi-images me-2"></i>Vos photos</h3>
            {% endif %}
        {% endif %}

        {% if gallery.photos|length == 0 and not gallery.hasFilms %}
            <p class="text-center text-muted py-5">La galerie est vide pour le moment. Le photographe ajoutera bientôt vos contenus.</p>
        {% elseif gallery.photos|length > 0 %}
            <div class="photo-grid">
                {% for photo in gallery.photos %}
                    <div class="photo-card client-photo" data-aos="fade-up" data-aos-delay="{{ (loop.index0 % 4) * 50 }}">
                        <a class="glightbox" href="{{ path('app_client_gallery_photo', { token: gallery.token, photoId: photo.id }) }}"
                           data-gallery="client" data-title="{{ photo.title }}">
                            <img src="{{ path('app_client_gallery_photo', { token: gallery.token, photoId: photo.id }) }}" alt="{{ photo.title }}" loading="lazy">
                        </a>
                        {% if gallery.allowDownload %}
                            <a href="{{ path('app_client_gallery_download', { token: gallery.token, photoId: photo.id }) }}"
                               class="client-photo-download" title="Télécharger" aria-label="Télécharger {{ photo.title }}">
                                <i class="bi bi-download"></i>
                            </a>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <div class="text-center mt-5 small text-muted">
            <p class="mb-1"><i class="bi bi-shield-check me-1"></i>Cette galerie est privée. Le lien et le mot de passe vous sont strictement personnels.</p>
            {% if gallery.expiresAt %}
                <p class="mb-0">Accès valable jusqu'au {{ gallery.expiresAt|date('d/m/Y') }}.</p>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
