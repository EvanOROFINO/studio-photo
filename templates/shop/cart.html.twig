{% extends 'base.html.twig' %}

{% block title %}Mon panier — {{ studio_name }}{% endblock %}

{% block body %}
<header class="page-header">
    <div class="container">
        <h1>Mon panier</h1>
        {% if items|length > 0 %}
            <p>{{ items|length }} article{{ items|length > 1 ? 's' : '' }}</p>
        {% endif %}
    </div>
</header>

<section class="section">
    <div class="container" style="max-width: 950px;">
        {% if items|length == 0 %}
            <div class="text-center py-5">
                <i class="bi bi-bag text-muted" style="font-size: 4rem;"></i>
                <p class="lead text-muted mt-3">Votre panier est vide.</p>
                <a href="{{ path('app_shop_index') }}" class="btn btn-dark mt-2">Voir la boutique</a>
            </div>
        {% else %}
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-0">
                            {% for item in items %}
                                {% set p = item.product %}
                                <div class="cart-line d-flex align-items-center p-3 border-bottom">
                                    {% set img = p.imageName ? asset('uploads/products/' ~ p.imageName) : 'https://picsum.photos/seed/product' ~ p.id ~ '/300/300' %}
                                    <img src="{{ img }}" alt="{{ p.title }}" class="cart-line-img me-3">
                                    <div class="flex-grow-1">
                                        <h6 class="serif mb-0">
                                            <a href="{{ path('app_shop_show', { slug: p.slug }) }}" class="text-decoration-none text-dark">{{ p.title }}</a>
                                        </h6>
                                        <small class="text-muted">{{ p.format }}</small>
                                    </div>
                                    <form method="post" action="{{ path('app_cart_update', { id: p.id }) }}" class="d-flex align-items-center me-3">
                                        <input type="number" name="quantity" value="{{ item.quantity }}" min="0"
                                            {% if not p.printOnDemand %}max="{{ p.stock }}"{% endif %}
                                            class="form-control form-control-sm" style="width: 72px;"
                                            onchange="this.form.submit()">
                                    </form>
                                    <div class="text-end" style="min-width: 90px;">
                                        <strong>{{ item.lineTotal|number_format(0, ',', ' ') }} €</strong>
                                        <a href="{{ path('app_cart_remove', { id: p.id }) }}" class="d-block small text-danger text-decoration-none mt-1">
                                            <i class="bi bi-x"></i> Retirer
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="mt-3 d-flex justify-content-between">
                        <a href="{{ path('app_shop_index') }}" class="btn btn-outline-dark">
                            <i class="bi bi-arrow-left me-1"></i>Continuer mes achats
                        </a>
                        <a href="{{ path('app_cart_clear') }}" class="btn btn-link text-danger text-decoration-none">
                            Vider le panier
                        </a>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h5 class="serif mb-3">Récapitulatif</h5>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Sous-total</span>
                                <strong>{{ subtotal|number_format(0, ',', ' ') }} €</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-3 text-muted small">
                                <span>Livraison France</span>
                                <span>8 €</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between mb-3">
                                <strong>Total TTC</strong>
                                <strong class="h5 mb-0">{{ (subtotal + 8)|number_format(0, ',', ' ') }} €</strong>
                            </div>
                            <a href="{{ path('app_order_new') }}" class="btn btn-dark w-100 btn-lg">
                                <i class="bi bi-credit-card me-2"></i>Commander
                            </a>
                            <p class="small text-muted mt-3 mb-0 text-center">
                                <i class="bi bi-shield-lock me-1"></i>Paiement sécurisé Stripe
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
