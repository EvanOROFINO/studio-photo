###> studio-photo ###
# Photos uploaded via admin (never commit user content)
/public/uploads/photos/*
!/public/uploads/photos/.gitkeep
/public/uploads/articles/*
!/public/uploads/articles/.gitkeep
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep
/public/uploads/before-after/*
!/public/uploads/before-after/.gitkeep

# LiipImagineBundle generated thumbnails — regenerated on demand
/public/media/cache/

# Private client galleries (stored outside public/)
/var/client-galleries/

# Release artifacts
/build/
/dist/
/release/
*.zip

