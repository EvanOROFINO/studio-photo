# =============================================================================
# .env.prod.dist — Template des variables de production
# =============================================================================
# 1. Sur le serveur, copier ce fichier en .env.prod.local
# 2. Remplir les valeurs avec vos vraies clés
# 3. Le fichier .env.prod.local est ignoré par Git (jamais commité)
# =============================================================================

APP_ENV=prod
APP_DEBUG=0

# Générer un secret aléatoire avec :
#   php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=A_CHANGER_AVEC_UNE_VRAIE_VALEUR_ALEATOIRE

# URL publique du site (sans trailing slash) — utilisée pour les URLs absolues
# dans les emails, le sitemap, les retours Stripe…
DEFAULT_URI=https://votre-domaine.fr

# Base MySQL/MariaDB de production
# Format : mysql://USER:PASSWORD@HOST:3306/DBNAME?serverVersion=...&charset=utf8mb4
DATABASE_URL="mysql://user:password@127.0.0.1:3306/dbname?serverVersion=10.6&charset=utf8mb4"

# Mailer (SMTP, Sendgrid, Mailgun, Brevo, etc.)
# Exemples :
#   smtp://user:pass@smtp.gmail.com:587
#   sendgrid+api://API_KEY@default
#   brevo+api://API_KEY@default
MAILER_DSN=smtp://user:password@smtp.exemple.fr:587

# Stripe (laisser vide pour rester en mode démo)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Messenger (laisser tel quel si vous n'utilisez pas de queue externe)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
