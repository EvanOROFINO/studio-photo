# =============================================================================
# .env.prod.dist — Template des variables de production
# =============================================================================
# 1. Sur le serveur, copier ce fichier en .env.prod.local
# 2. Remplir les valeurs avec vos vraies clés
# 3. Le fichier .env.prod.local est ignoré par Git (jamais commité)
# =============================================================================

APP_ENV=prod
APP_DEBUG=0

# Générer un secret aléatoire avec :
#   php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=A_CHANGER_AVEC_UNE_VRAIE_VALEUR_ALEATOIRE

# URL publique du site (sans trailing slash) — utilisée pour les URLs absolues
# dans les emails, le sitemap, les retours Stripe…
DEFAULT_URI=https://votre-domaine.fr

# Base MySQL/MariaDB de production
# Format : mysql://USER:PASSWORD@HOST:3306/DBNAME?serverVersion=...&charset=utf8mb4
DATABASE_URL="mysql://user:password@127.0.0.1:3306/dbname?serverVersion=10.6&charset=utf8mb4"

# Mailer (SMTP, Sendgrid, Mailgun, Brevo, etc.)
# Exemples :
#   smtp://user:pass@smtp.gmail.com:587
#   sendgrid+api://API_KEY@default
#   brevo+api://API_KEY@default
MAILER_DSN=smtp://user:password@smtp.exemple.fr:587

# Stripe (laisser vide pour rester en mode démo)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Messenger (laisser tel quel si vous n'utilisez pas de queue externe)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Premier compte administrateur, créé au premier déploiement s'il n'existe aucun compte
# (voir bin/post-deploy.sh ou docker-entrypoint.sh). 12 caractères minimum.
# Retirez ADMIN_PASSWORD de ce fichier une fois le compte créé.
# Sans ces deux lignes, post-deploy.sh vous pose la question (mot de passe masqué).
#ADMIN_EMAIL=vous@exemple.fr
#ADMIN_PASSWORD=

# Noms de domaine des deux sites (utilisés par le déploiement Docker au premier démarrage ;
# modifiables ensuite dans l'admin > Sites). Les deux domaines doivent pointer vers
# la même application : le site affiché dépend du nom de domaine demandé.
#SITE_PHOTO_DOMAIN=mon-studio.fr
#SITE_VIDEO_DOMAIN=mon-studio-video.fr

# Coordonnées affichées sur le site (contact, pied de page, mentions, WhatsApp, e-mails)
# Valeurs de démonstration tant que ces lignes sont absentes : à renseigner avant la mise en ligne.
CONTACT_EMAIL=contact@mon-studio.fr
CONTACT_PHONE="06 00 00 00 00"
STUDIO_CITY=Lyon
#STUDIO_NAME="Studio Photo/Vidéos"
#STUDIO_TAGLINE="Photographe portraitiste & événementiel"
#SOCIAL_INSTAGRAM=https://instagram.com/mon_compte
#SOCIAL_FACEBOOK=https://facebook.com/ma_page

# Adresse d'expédition des e-mails du site : une boîte du nom de domaine (SPF/DKIM du domaine),
# sinon les messages sont rejetés ou classés en spam.
MAIL_FROM=no-reply@mon-studio.fr
